+// gates/regress/248-coach-plan-opens-from-home.js - THE COACH'S PLAN OPENS FROM HOME BY A TAP. TCID / USID.
+//
+// WHY [#553 B3, jobs/the-mastery-plan-sheet-cannot-be-opened-since-the-home-coach-card-stopped-rendering-2026-11-25; Kunal's q28 pick A
+// (run-answers orchestrator-B14-DESK-ANSWERS-Q25-Q28-Q29-2026-11-25): "open the Mastery plan from the slim coach line on Home"]: the plan
+// sheet (Your coach - Today's plan, the training rows, the Mastery plan with its Run rows) opened only through setCoachOpen(true), and both
+// calls sat inside the Home coach CARD that nothing has rendered since #314 (2026-09-06), so no player could open it. The slim coach line
+// that replaced the card now opens it (amber flags/amber-553-coach-line-opens-the-plan).
+// WHAT IT READS: the bundle under test (CT_APP), a fresh store (not Pro, no free preview used), at kunal761, 320x568 (se) and 375x679
+// (kunal). The line is found by WHAT IT SAYS ('\u{1F393} ... open'), the sheet by its words ('Your coach' and "Today's plan") and the Run
+// rows by their text, never by a hook this build added (CLAUDE.md, #432), so the tree before is read the same way. The tap is a player's:
+// the line scrolled into Home's own scroller, its rect re-read, elementFromPoint at the tap point IS the line, then a mouse click there.
+//  (1) PRECONDITION the coach line is on Home and the tap point is the line.
+//  (2) after the tap the plan sheet is up: 'Your coach' and "Today's plan" are on screen, over Home.
+//  (3) its Run rows are REACHABLE: at least one 'Run' button, and the first one, scrolled into view by the sheet's own scroller (a box with
+//      overflow-y auto that actually moves it), is on screen and is the element at its centre.
+//  (4) zero app errors.
+// KNOW ITS LIMIT: the Pro path and the last-free-preview path (the upgrade message) are not driven; the streak-at-risk line (which
+// dismisses) is not seeded.
+const L=require('../lib');const H=require('../drive/home');
+const LINE=/^\u{1F393} .* open$/u;
+L.run(async()=>{
+  for(const geo of ['kunal761','se','kunal']){
+    const tag='TCID '+geo;const b=await L.launch({geo,name:'g248-'+geo});
+    let ok=true;try{await b.open();await b.settle(1000);await H.fresh(b);}catch(e){ok=false;L.note(tag+' did not reach Home: '+String(e.message||e).slice(0,140));}
+    // (1) the line, scrolled into Home's scroller, hit-tested at its centre
+    const hit=ok?await b.page.evaluate((src)=>{const re=new RegExp(src,'u');const el=[...document.querySelectorAll('button')].find(x=>re.test((x.innerText||'').replace(/\s+/g,' ').trim())&&x.getBoundingClientRect().width>1);
+      if(!el)return {found:false};el.scrollIntoView({block:'center'});const r=el.getBoundingClientRect();const x=r.left+r.width/2,y=r.top+r.height/2;const at=document.elementFromPoint(x,y);
+      return {found:true,x,y,h:Math.round(r.height*10)/10,top:Math.round(r.top*10)/10,onTop:!!at&&(el===at||el.contains(at)),inView:y>0&&y<innerHeight};},LINE.source):{found:false};
+    L.say(hit.found&&hit.onTop&&hit.inView,tag+' PRECONDITION the coach line is on Home and the tap point is the line (top '+hit.top+', height '+hit.h+')',hit);
+    if(hit.found&&hit.onTop){await b.page.mouse.click(hit.x,hit.y);await b.settle(1500);}
+    // (2) the sheet
+    const sh=await b.page.evaluate(()=>{const vis=(e)=>{const r=e.getBoundingClientRect();return r.width>1&&r.height>1&&r.bottom>0&&r.top<innerHeight;};
+      const leaf=(re)=>[...document.querySelectorAll('div,span')].find(e=>e.children.length===0&&re.test((e.textContent||'').trim())&&vis(e));
+      const yc=leaf(/^Your coach$/),tp=leaf(/^Today's plan$/);let over=false;
+      if(yc){let s=yc;while(s&&getComputedStyle(s).position!=='fixed')s=s.parentElement;over=!!s&&(parseInt(getComputedStyle(s).zIndex,10)||0)>500;}
+      return {yourCoach:!!yc,todaysPlan:!!tp,over};});
+    L.say(sh.yourCoach&&sh.todaysPlan&&sh.over,tag+' the tap opens the coach\'s plan sheet over Home (Your coach '+sh.yourCoach+', Today\'s plan '+sh.todaysPlan+', a fixed layer above Home '+sh.over+')',sh);
+    // (3) a Run row reachable by the sheet's own scroller
+    const run=await b.page.evaluate(async()=>{const btn=[...document.querySelectorAll('button')].filter(x=>/(^|\s)Run$/.test((x.innerText||'').trim()));if(!btn.length)return {n:0};
+      const el=btn[0];let sc=el.parentElement;while(sc&&!(/(auto|scroll)/.test(getComputedStyle(sc).overflowY)&&sc.scrollHeight>sc.clientHeight+1))sc=sc.parentElement;
+      const r0=el.getBoundingClientRect();if(sc){sc.scrollTop+=r0.top+r0.height/2-innerHeight/2;await new Promise(r=>setTimeout(r,250));}
+      const r=el.getBoundingClientRect();const x=r.left+r.width/2,y=r.top+r.height/2;const at=document.elementFromPoint(x,y);
+      return {n:btn.length,scroller:!!sc,moved:Math.round(r0.top-r.top),inView:y>0&&y<innerHeight,onTop:!!at&&(el===at||el.contains(at)),t:(el.innerText||'').trim()};});
+    L.say(run.n>=1,tag+' DENOMINATOR the plan sheet shows its Run rows ('+run.n+')',run);
+    L.say(run.n>=1&&run.inView&&run.onTop,tag+' the first Run row is reachable: brought on screen'+(run.scroller?' by the sheet\'s own scroller (moved '+run.moved+'px)':' (already on screen)')+' and the element at its centre is that button',run);
+    L.say(b.errs.length===0,tag+' zero app errors',b.errs.slice(0,3));await b.close();}
+},'248-coach-plan-opens-from-home');
